{
  "name": "passbox-core",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=!passbox-core build",
    "build:wasm": "pnpm --filter @passbox/core-wasm build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pack": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "typescript": "5.9.3"
  }
}
