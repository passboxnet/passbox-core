#!/bin/sh
# Rejects AI attribution trailers in commit messages, whatever tool wrote them.
# Enable once per clone: git config core.hooksPath .githooks
if grep -qiE '^(co-authored-by:.*(anthropic|claude)|claude-session:)|generated with \[claude code\]|claude\.ai/code/session_' "$1"; then
  echo 'commit-msg: remove the Co-Authored-By / Claude-Session / "Generated with" lines' >&2
  exit 1
fi
